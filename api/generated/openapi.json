  "info": {
    "title": "Shift Flow API",
    "description": "Scheduling and shift assignment API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "test-employee@example.com",
            "description": "Email address used as the login identifier."
          },
          "password": {
            "type": "string",
            "example": "test-employee@example.com",
            "description": "Account password (equals the email address for seeded dev accounts)."
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CreateScheduleDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "timeZone"
        ]
      },
      "ScheduleEntity": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "IN_REVIEW",
              "AWAITING_APPROVAL",
              "APPROVED",
              "REJECTED"
            ],
            "type": "string"
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true
          },
          "shifts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShiftEntity"
            }
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
